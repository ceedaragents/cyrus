# Dockerfile for running the Cyrus edge worker (apps/cli) as a long-running
# service, e.g. on Railway. Builds from the monorepo root because apps/cli
# depends on several workspace packages (cyrus-core, cyrus-edge-worker, etc).
#
# Runtime notes:
#  - Set HOME to a mounted persistent volume (e.g. /data) so ~/.cyrus survives
#    redeploys — it holds config.json, OAuth tokens, cloned repos, and git
#    worktrees.
#  - Set CYRUS_HOST_EXTERNAL=true so the webhook server binds 0.0.0.0.
#  - First-run setup (Linear OAuth, repo wizard) is interactive and won't work
#    headless here — generate ~/.cyrus/config.json locally first, then place
#    it on the mounted volume before the service starts.

FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git jq ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.33.1 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
# Build only cyrus-ai (apps/cli) and its workspace dependencies.
RUN pnpm --filter cyrus-ai... build

WORKDIR /app/apps/cli
ENV NODE_ENV=production
ENV CYRUS_HOST_EXTERNAL=true
ENV CYRUS_SERVER_PORT=3456
EXPOSE 3456

CMD ["node", "dist/src/app.js", "self-auth-linear"]
